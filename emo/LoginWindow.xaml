<Window x:Class="emo.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация" Style="{StaticResource {x:Type Window}}"
        Width="380" Height="200" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Введите логин:" />
        <TextBox x:Name="Login" Margin="4" />
        <Button Content="Войти" Foreground="White" FontWeight="Bold" IsDefault="True" Click="SignIn" />
    </StackPanel>
</Window>
