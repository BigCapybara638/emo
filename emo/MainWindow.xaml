<Window x:Class="emo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь — Каталог" Style="{StaticResource {x:Type Window}}"
        Width="1080" Height="760" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" Icon="Resources/icon.ico">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#D2F6E7" Margin="0,0,0,8">
            <Button x:Name="BackButton" ToolTip="Вернуться на предыдущую страницу. Несохранённый новый заказ можно отменить." Content="Назад" Click="BackClick" />
            <Image Source="Resources/icon.ico" Width="40" Height="40" Margin="8" ToolTip="Логотип компании «Чудо Обувь»." />
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Выйти" ToolTip="Завершить текущий сеанс и вернуться к окну авторизации." Click="Logout" />
            <TextBlock x:Name="UserName" ToolTip="Текущий пользователь. Гость может только просматривать товары." DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>
        <TabControl x:Name="Pages" BorderThickness="0">
            <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>
            <TabItem>
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBox x:Name="Search" Width="240" Margin="4" ToolTip="Поиск по названию и описанию" TextChanged="Filter" />
                        <ComboBox x:Name="Category" ToolTip="Фильтр по категории. «Все категории» отключает фильтрацию." Width="210" SelectionChanged="Filter" />
                        <ComboBox x:Name="Sort" ToolTip="Сортировка по цене со скидкой сохраняется при поиске и фильтрации." Width="210" SelectedIndex="0" SelectionChanged="Filter">
                            <ComboBoxItem Content="Цена: по возрастанию" />
                            <ComboBoxItem Content="Цена: по убыванию" />
                        </ComboBox>
                        <Button x:Name="CartButton" ToolTip="Просмотреть выбранные позиции, изменить количество и подтвердить заказ." Content="Корзина" Click="OpenCart" />
                        <Button x:Name="OrdersButton" ToolTip="Открыть список заказов. Доступно менеджеру и администратору." Content="Заказы" Click="OpenOrders" />
                    </StackPanel>
                    <ListBox x:Name="Products" ToolTip="Выберите модель обуви, чтобы открыть описание, размеры и доступные действия." SelectionChanged="SelectProduct" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border ToolTip="{Binding Description}" Padding="10" Margin="0,3" BorderBrush="#70B2AF" BorderThickness="1">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" />
                                        <Style.Triggers><DataTrigger Binding="{Binding LowStock}" Value="True"><Setter Property="Background" Value="#FF8080" /></DataTrigger></Style.Triggers>
                                    </Style></Border.Style>
                                    <Grid MinHeight="130">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding ImagePath}" Width="95" Height="100" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Manufacture, StringFormat=Производство: {0}}" />
                                            <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" />
                            <TextBlock Text="{Binding Subcategory, StringFormat=Подкатегория: {0}}" />
                                            <TextBlock Text="{Binding Composition, StringFormat=Состав: {0}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CountText, StringFormat=Количество: {0}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem>
                <DockPanel Margin="20">
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel>
                        <TextBlock Text="Размер:" VerticalAlignment="Center" />
                        <ComboBox x:Name="SizeChoice" SelectionChanged="ValidateProductQuantity" ToolTip="Доступные размеры и актуальный остаток пар на складе." Width="230" />
                        <TextBlock Text="Количество:" VerticalAlignment="Center" />
                        <TextBox x:Name="Quantity" PreviewTextInput="OnlyDigits" DataObject.Pasting="PasteDigits" TextChanged="ValidateProductQuantity" ToolTip="Целое положительное количество пар выбранного размера." Text="1" Width="65" VerticalContentAlignment="Center" />
                        <Button x:Name="AddButton" ToolTip="Добавить выбранный размер и количество в корзину или текущий заказ." Content="В корзину" Click="AddItem" />
                        <Button x:Name="BuyButton" ToolTip="Перейти к подтверждению заказа выбранного товара без корзины." Content="Оформить сразу" Click="BuyNow" />
                    </WrapPanel>
                        <TextBlock x:Name="QuantityHint" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProductDetails">
                            <Image Source="{Binding ImagePath}" Height="210" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PriceText}" FontSize="20" Foreground="#438481" />
                            <TextBlock Text="{Binding Manufacture, StringFormat=Производство: {0}}" />
                            <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" />
                            <TextBlock Text="{Binding Subcategory, StringFormat=Подкатегория: {0}}" />
                            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Composition, StringFormat=Состав: {0}}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SizeRange" ToolTip="Все размеры этой модели. Для заказа доступны размеры с положительным остатком." TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem>
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <Button Content="Новый заказ" ToolTip="Создать заказ с выбором клиента, даты и товаров из каталога." Click="NewOrder" />
                        <Button Content="Состав заказа" ToolTip="Просмотреть модели, размеры, количество, сохранённые цены и общую сумму." Click="ViewOrder" />
                        <Button Content="Удалить заказ" ToolTip="Удалить выбранный заказ после подтверждения. Все пары вернутся на склад." Click="DeleteOrder" />
                    </StackPanel>
                    <DataGrid x:Name="Orders" ToolTip="Выберите заказ, затем откройте его состав или удалите заказ с возвратом товаров." AutoGeneratingColumn="GenerateColumn" />
                </DockPanel>
            </TabItem>
            <TabItem>
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Дата:" VerticalAlignment="Center" />
                        <DatePicker x:Name="OrderDate" ToolTip="Дата заказа. Дату существующего заказа может изменить только администратор." Width="150" Margin="4" />
                        <TextBlock Text="Клиент:" VerticalAlignment="Center" />
                        <ComboBox x:Name="Customer" ToolTip="Фамилия, имя и отчество клиента. При создании заказа сотрудник выбирает клиента из списка." Width="400" DisplayMemberPath="ФИО" SelectedValuePath="id" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock x:Name="Total" FontSize="22" FontWeight="Bold" ToolTip="Общая сумма всех позиций заказа с учётом количества и сохранённых скидок." />
                        <WrapPanel x:Name="QuantityEditor">
                            <TextBlock Text="Количество:" VerticalAlignment="Center" />
                            <TextBox x:Name="LineQuantity" Width="80" Margin="4" VerticalContentAlignment="Center"
                                     ToolTip="Новое целое положительное количество пар выбранной позиции."
                                     PreviewTextInput="OnlyDigits" DataObject.Pasting="PasteDigits" />
                            <Button x:Name="ChangeQuantityButton" Content="Изменить количество" Click="ChangeQuantity" ToolTip="Сначала выберите позицию. Изменение количества пересчитает остаток на складе." />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Добавить товар из каталога" ToolTip="Открыть общий каталог с поиском и выбрать товар, размер и количество." Click="ChooseItem" />
                            <Button x:Name="RemoveButton" ToolTip="Удалить выбранную позицию. Для оформленного заказа товар вернётся на склад." Content="Удалить позицию" Click="RemoveItem" />
                            <Button x:Name="SaveButton" ToolTip="Подтвердить новый заказ или сохранить дату существующего заказа (администратор)." Content="Подтвердить заказ" Click="SaveOrder" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid SelectionChanged="SelectLine" x:Name="Items" ToolTip="Выберите позицию заказа для изменения количества или удаления." AutoGeneratingColumn="GenerateColumn" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
